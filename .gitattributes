# Line endings fixed, so the wheel built from a checkout is the same bytes on any OS.
gen/** text eol=lf
# Vendored by sha256 (lib/js/README.md), so its bytes must not depend on the checkout's OS.
lib/js/** text eol=lf
# Written by buf generate (gen/README.md): collapsed in diffs, and not counted as the repository's own code.
gen/go/machinery/** linguist-generated=true
gen/python/src/** linguist-generated=true
