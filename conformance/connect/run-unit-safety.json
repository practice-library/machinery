{
  "about": "One unit's host under the rules a run must keep: robots.txt first, listed host only, a 429 or 5xx never a verdict, the budget never exceeded.",
  "carriedFrom": "conformance/cases/run-unit-safety.json",
  "procedure": "machinery.plugin.v1alpha1.PluginService/RunUnit",
  "defaults": {
    "caps": {
      "timeSeconds": 60,
      "outputBytes": 1048576
    },
    "network": {
      "replay": {
        "start": "2026-10-31T12:00:00Z",
        "exchanges": {}
      }
    },
    "input": {
      "id": "host:docs.example.com",
      "shardKey": "docs.example.com",
      "pacing": {
        "minIntervalSeconds": 2.0
      },
      "budget": {
        "requests": 10
      },
      "host": {
        "host": "docs.example.com",
        "format": "html",
        "maxBytes": 2000000,
        "timeoutSeconds": 30
      },
      "userAgent": "practice-library-graphs/1 (+https://github.com/practice-library/graphs)",
      "retryAfterMaxSeconds": 60,
      "facts": [
        {
          "node": "rule.example.a",
          "source": "https://docs.example.com/a",
          "measuredAt": "2026-09-01",
          "quote": {
            "text": "Each key may send 20 requests per second."
          }
        },
        {
          "node": "rule.example.b",
          "source": "https://docs.example.com/b",
          "measuredAt": "2026-09-02",
          "quote": {
            "text": "The free plan includes 1,000 calls."
          }
        }
      ]
    }
  },
  "cases": [
    {
      "name": "both quotes on their pages: unchanged, one request per page after robots.txt",
      "carries": "both quotes on their pages: unchanged, one request per page after robots.txt",
      "request": {
        "network": {
          "replay": {
            "exchanges": {
              "https://docs.example.com/robots.txt": [
                {
                  "status": 200,
                  "headers": {
                    "content-type": "text/plain"
                  },
                  "body": "User-agent: *\nDisallow: /private/\n"
                }
              ],
              "https://docs.example.com/a": [
                {
                  "status": 200,
                  "headers": {
                    "content-type": "text/html; charset=utf-8"
                  },
                  "body": "<p>Each key may send <b>20</b> requests per second.</p>"
                }
              ],
              "https://docs.example.com/b": [
                {
                  "status": 200,
                  "headers": {
                    "content-type": "text/html; charset=utf-8"
                  },
                  "body": "<p>The free plan includes 1,000 calls.</p>"
                }
              ]
            }
          }
        }
      },
      "expect": {
        "code": "ok",
        "envelope": {
          "ok": true,
          "data": {
            "requests": 3,
            "robots": {
              "verdict": "allowed"
            },
            "results": [
              {
                "node": "rule.example.a",
                "outcome": "unchanged"
              },
              {
                "node": "rule.example.b",
                "outcome": "unchanged"
              }
            ],
            "notReached": []
          }
        }
      }
    },
