{
  "about": "The design review measured, on 81 stored quotes over 40 pages read once each: an extractor that replaces every tag with a space misses 12 quotes that are on their pages (false quote-gone); a careful one misses 2, both markdown table rows that never appear in page text. Each case is the smallest element around one of those 12 quotes, with the stored quote and the outcome a conforming plugin must give: unchanged.",
  "carriedFrom": "conformance/cases/run-unit-design-review.json",
  "procedure": "machinery.plugin.v1alpha1.PluginService/RunUnit",
  "defaults": {
    "caps": {
      "timeSeconds": 60,
      "outputBytes": 1048576
    },
    "network": {
      "replay": {
        "start": "2026-10-31T12:00:00Z",
        "exchanges": {
          "https://docs.github.com/robots.txt": [
            {
              "status": 200,
              "headers": {
                "content-type": "text/plain"
              },
              "body": "User-agent: *\n"
            }
          ]
        }
      }
    },
    "input": {
      "id": "host:docs.github.com",
      "shardKey": "docs.github.com",
      "pacing": {
        "minIntervalSeconds": 2.0
      },
      "budget": {
        "requests": 10
      },
      "host": {
        "host": "docs.github.com",
        "format": "html",
        "maxBytes": 2000000,
        "timeoutSeconds": 30
      },
      "userAgent": "practice-library-graphs/1 (+https://github.com/practice-library/graphs)",
      "retryAfterMaxSeconds": 60,
      "facts": []
    }
  },
